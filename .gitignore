# --- Build output (regenerated by install-launcher.ps1) ---
launcher/.gradle/
launcher/build/
launcher/app/build/
*.apk
*.aab
*.dex
*.class

# Machine-specific: path to the Android SDK on this PC
launcher/local.properties

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# --- Device data: not for a public repo ---
# Backups hold the box's serial number, android_id, Bluetooth MAC and full settings.
backup/*
# ...except the arranged app order (package names only), the example for setup-new-box.ps1 -PrefsFile
!backup/s3gen-home-prefs.xml

# Screenshots taken while setting up (~55 MB; show the Wi-Fi name)
shots/

# Full-size wallpaper originals (only the fitted copies in res/drawable-nodpi are built)
launcher/wallpaper-originals/

local.txt